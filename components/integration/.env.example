# 안심온 — 세 서비스가 공유하는 단일 .env
#   cp .env.example .env   (Windows: copy .env.example .env)
# 이 파일만 저장소에 올린다. .env 는 .gitignore 로 막혀 있다.

# ── 외부 API 키 ──────────────────────────────────────────────────────────
# 앨런(주최측 LLM). client_id 로 쓰이는 UUID.
ALAN_API_KEY=
ALAN_API_MODE=alan_query
# POST 엔드포인트를 받으면 여기에 넣고 ALAN_API_MODE=openai 로 바꾼다. 비우면 앨런 기본 주소.
ALAN_API_URL=
LLM_MODEL=
# 앨런 GET 쿼리스트링 한도(바이트). prompt_builder 가 이 안에 들어가게 프롬프트를 줄인다.
ALAN_QUERY_MAX_BYTES=3900

# 서울 열린데이터광장 인증키(hex). 이름과 달리 URL 이 아니다 — shelter_client 가 키로 쓴다.
SHELTER_API_BASE_URL=
# 포털 > 데이터셋 > Open API 탭의 '서비스명'. 무더위쉼터 데이터셋인지 확인할 것.
SHELTER_SERVICE=TbGtnHwcwP
# 공공 무더위쉼터 데이터가 있는 지역(법정동코드 앞자리). 서울만 있다.
# 그 외 지역은 쉼터를 조회하지 않고 통화 질문에서도 뺀다.
SHELTER_REGION_PREFIX=11
TMAP_APP_KEY=
KMA_API_KEY=

# 통화 요약(gpt-4o). ALAN_API_MODE=openai 로 쓸 때의 LLM 키이기도 하다.
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-4o

# ClawOps 070 발신
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_NUMBER=

# ── 백엔드(Spring) ───────────────────────────────────────────────────────
# 결과를 POST {ANSIMON_BACKEND_BASE_URL}/internal/v1/contact/results 로 보낸다.
# 비워두면 전송하지 않고 본문만 출력한다 — 백엔드 없이도 전 구간을 돌려볼 수 있다.
ANSIMON_BACKEND_BASE_URL=
ANSIMON_BACKEND_TOKEN=
BACKEND_TIMEOUT_SEC=15

# ── 서비스 주소 ──────────────────────────────────────────────────────────
RAG_PORT=8000
PHONE_API_PORT=9000
CONNECTION_PORT=7000
RAG_BASE_URL=http://localhost:8000
PHONE_API_BASE_URL=http://localhost:9000
# 통화 결과 콜백을 받을 주소. 비우면 http://localhost:{CONNECTION_PORT} 를 쓴다.
CONNECTION_CALLBACK_URL=

# ── 동작 설정 ────────────────────────────────────────────────────────────
CALL_RESULT_TIMEOUT_SEC=300
RAG_TIMEOUT_SEC=120
QUESTION_TIMEOUT_SEC=30
PHONE_DISPATCH_TIMEOUT_SEC=20
RETRY_AFTER_MIN=30
LOCK_TTL_SEC=300
# 자동 전화를 허용할 consent_status 값
CONSENT_OK_VALUES=AGREED,GRANTED,CONSENTED
# 쉼터 needs_review 일 때 1=전화 보류 / 0=전화는 걸고 표시만
SHELTER_REVIEW_BLOCKS_CALL=1

# run_demo.py 기본 수신번호. 팀원 본인 번호만 — 실제 어르신 번호 금지.
DEMO_PHONE=
