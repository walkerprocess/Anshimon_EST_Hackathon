# TMAP 앱키 — https://tmapapi.tmapmobility.com 마이페이지 > 앱키
TMAP_APP_KEY=

# 쉼터 목록 (둘 중 하나만 있으면 된다)
#  1) 서울열린데이터광장 OpenAPI
SHELTER_API_BASE_URL=          # 인증키 (이름은 URL 이지만 값은 키다)
SHELTER_SERVICE=               # 포털 > 데이터셋 > Open API 탭의 '서비스명'
#  2) 포털에서 내려받은 CSV/JSON 파일 경로
SHELTER_FILE=

# 선택 — 기본값으로 충분하다
TMAP_SEARCH_OPTION=30          # 0추천 4대로우선 10최단 30최단+계단제외(고령자 기본)
WALK_SPEED_KMH=3               # 고령자 보행속도. 0 이면 TMAP 기본값
